{
  "name": "@osm-editor-kit/street-imagery",
  "version": "0.1.0-alpha.1",
  "description": "Street-level imagery providers, GeoJSON, viewfields, tiles, and viewer helpers (Mapillary, Panoramax, and more).",
  "homepage": "https://github.com/osmberlin/street-space-editor/tree/main/packages/street-imagery",
  "license": "MIT",
  "author": "Tobias Jordans",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/osmberlin/street-space-editor.git",
    "directory": "packages/street-imagery"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "scripts": {
    "build": "tsup && rm -f .tsbuildinfo && tsc -p tsconfig.build.json",
    "type-check": "tsc --noEmit",
    "test-run": "bun test src",
    "prepublishOnly": "bun run build && bun ../../scripts/package-exports-for-publish.ts",
    "postpublish": "bun ../../scripts/package-exports-restore.ts",
    "prepack": "bun ../../scripts/package-exports-for-publish.ts",
    "postpack": "bun ../../scripts/package-exports-restore.ts"
  },
  "dependencies": {
    "@mapbox/vector-tile": "^3.0.0",
    "pbf": "^5.1.0"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "bun-types": "^1.2.20",
    "maplibre-gl": "^6.7.0",
    "tsup": "^8.5.1",
    "typescript": "^7.0.0",
    "vite": "^8.0.0"
  },
  "publishExports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  }
}
