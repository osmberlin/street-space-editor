{
  "name": "@osm-editor-kit/osm-coverage",
  "version": "0.1.0-alpha.4",
  "description": "Incremental OSM coverage fetching for map viewports with TanStack Query session state.",
  "homepage": "https://github.com/osmberlin/street-space-editor/tree/main/packages/osm-coverage",
  "license": "MIT",
  "author": "Tobias Jordans",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/osmberlin/street-space-editor.git",
    "directory": "packages/osm-coverage"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./dev-osm-map-fixture": "./src/dev-osm-map-fixture/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "scripts": {
    "build": "tsup && rm -f .tsbuildinfo && tsc -p tsconfig.build.json",
    "type-check": "tsc --noEmit",
    "test-run": "bun test src/test",
    "prepublishOnly": "bun run build && bun ../../scripts/package-exports-for-publish.ts",
    "postpublish": "bun ../../scripts/package-exports-restore.ts",
    "prepack": "bun ../../scripts/package-exports-for-publish.ts",
    "postpack": "bun ../../scripts/package-exports-restore.ts"
  },
  "dependencies": {
    "@osm-editor-kit/osm-data": "workspace:*",
    "@tanstack/react-query": "^5.85.5",
    "@turf/area": "^7.3.5",
    "@turf/bbox": "^7.3.5",
    "@turf/bbox-polygon": "^7.3.5",
    "@turf/difference": "^7.3.5",
    "@turf/flatten": "^7.3.5",
    "@turf/helpers": "^7.3.5",
    "@turf/intersect": "^7.3.5",
    "@turf/union": "^7.3.5"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/react": "^19.1.10",
    "bun-types": "^1.2.20",
    "react": "^19.1.1",
    "tsup": "^8.5.1",
    "typescript": "^7.0.0"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "publishExports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  }
}
