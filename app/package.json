    "@turf/destination": "^7.3.5",
    "@turf/helpers": "^7.3.5",
    "@turf/length": "^7.3.5",
    "@turf/nearest-point-on-line": "^7.3.5",
    "axios": "^1.11.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dayjs": "^1.11.13",
    "json5": "2.2.3",
    "lucide-react": "^1.25.0",
    "mapillary-js": "^4.1.2",
    "maplibre-gl": "^6.7.0",
    "motion": "^12.42.2",
    "osm-parking-tag-updater": "github:osmberlin/osm-tag-updater",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-map-gl": "^8.0.4",
