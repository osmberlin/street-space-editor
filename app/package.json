{
  "name": "@osm-editor-kit/street-space-editor",
  "version": "0.9.0",
  "private": true,
  "description": "Street Space Editor for OpenStreetMap",
  "keywords": [],
  "homepage": "https://osmberlin.github.io/street-space-editor/",
  "license": "MIT",
  "author": "Zlant",
  "type": "module",
  "scripts": {
    "predev": "bun run --filter @osm-editor-kit/osm-maplibre fetch-openfreemap-style && bun run scripts/ensure-dev-osm-fixture.ts",
    "dev": "vite",
    "build": "vite build",
    "build:paraglide": "paraglide-js compile --project ./project.inlang --outdir ./paraglide --strategy localStorage baseLocale",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "test-run": "bun test src/test"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@headlessui/react": "^2.2",
    "@inlang/paraglide-js": "^2.20.2",
    "@osm-editor-kit/maplibre-editor-layer-index": "^0.1.3",
    "@osm-editor-kit/osm-changeset": "workspace:*",
    "@osm-editor-kit/osm-coverage": "workspace:*",
    "@osm-editor-kit/osm-data": "workspace:*",
    "@osm-editor-kit/osm-editor-links": "workspace:*",
    "@osm-editor-kit/osm-lane-diagram": "workspace:*",
    "@osm-editor-kit/osm-lanes": "workspace:*",
    "@osm-editor-kit/osm-map-url": "workspace:*",
    "@osm-editor-kit/osm-maplibre": "workspace:*",
    "@osm-editor-kit/osm-oauth": "workspace:*",
    "@osm-editor-kit/osm-sidepath-tags": "workspace:*",
