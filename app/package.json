    "@osm-editor-kit/osm-tag-syntax": "workspace:*",
    "@osm-editor-kit/osm-ui": "workspace:*",
    "@osm-editor-kit/osm-way-chain": "workspace:*",
    "@osm-editor-kit/osm-way-edit": "workspace:*",
    "@osm-editor-kit/street-imagery": "workspace:*",
    "@osm-editor-kit/street-imagery-react": "workspace:*",
    "@osm-editor-kit/surface-smoothness-data": "^0.0.0",
    "@panoramax/web-viewer": "^5",
    "@rapideditor/country-coder": "^5.6.1",
    "@tanstack/react-hotkeys": "^0.10.0",
    "@tanstack/react-pacer": "^0.22.1",
    "@tanstack/react-query": "^5.85.5",
    "@tanstack/react-router": "^1.131.28",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.9",
